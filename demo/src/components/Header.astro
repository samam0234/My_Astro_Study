---
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'Astro 실습';
const links = [
  { href: '/', label: '홈' },
  { href: '/about', label: '소개' },
  { href: '/posts', label: '글' },
  { href: '/components', label: '부품' },
  { href: '/islands', label: '섬' },
  { href: '/feed', label: '피드' },
  { href: '/guestbook', label: '방명록' },
  { href: '/now', label: '지금' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" transition:persist>
  <a href="/">{siteName}</a>
  <nav>
    {
      links.map((link) => (
        <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
