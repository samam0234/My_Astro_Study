    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/">Astro 실습</a>
      <nav>
        <a href="/">홈</a>
        <a href="/about">소개</a>
        <a href="/posts">글</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
