---
import Base from '../../layouts/Base.astro';
import { notes } from '../../data/notes.js';
---

<Base title="글 — Astro 실습">
  <h1>글</h1>
  <p class="lede">폴더 <code>posts/index.astro</code>가 <code>/posts</code>입니다. 목록은 아직 코드 안의 배열입니다.</p>
  <ul class="note-list">
    {
      notes.map((note) => (
        <li>
          <a href={`/posts/${note.slug}`}>{note.title}</a>
          <p>{note.summary}</p>
        </li>
      ))
    }
  </ul>
</Base>
