---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
---

<Base title="부품 — Astro 실습" footer="이 페이지만 바닥 문구를 props로 바꿨습니다.">
  <h1>컴포넌트, props, slot</h1>
  <p class="lede">
    <code>Card</code>는 <code>title</code>과 <code>href</code>를 props로 받고, 본문과 <code>meta</code>는 slot입니다.
  </p>
  <Card title="이름이 있는 칸" href="/posts">
    <Fragment slot="meta">slot name=meta</Fragment>
    <p>이 문단은 이름 없는 기본 slot입니다. 부모 페이지가 내용을 채웁니다.</p>
  </Card>
</Base>
